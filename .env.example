# Avalanche Fuji (C-Chain)
AVAX_RPC=https://api.avax.network/ext/bc/C/rpc   # Fuji: https://api.avax-test.network/ext/bc/C/rpc
AVAX_CHAIN_ID=43114   # Fuji: 43113
USDC_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E   # Fuji USDC: 0x5425890298aed601595a70AB815c96711a31Bc65
EXPLORER=https://snowtrace.io

# U-bot treasury wallet (relayer / demo payer)
UBOT_WALLET_ADDRESS=0x...
UBOT_PRIVATE_KEY=0x...

# AI — Ubot (U-topia LLM) is the brain, but it is NOT a hard dependency.
#
# Audit 20 Oct 2026: llm.u-topia.com did not resolve, which took POST /turn down
# at 100% (HTTP 500 on every request). brain.py now degrades in three steps:
#   1. Ubot        (only if UBOT_LLM_URL is set AND reachable)
#   2. Anthropic   (only if ANTHROPIC_API_KEY is set and valid)
#   3. Local parser (always available, no network — covers balance, send,
#      invoices, confirm/cancel, history, contacts, help, Thai/EN/ES)
# So the product keeps working even if every LLM host is down.
UBOT_LLM_URL=            # leave EMPTY until the endpoint actually resolves
UBOT_LLM_KEY=
UBOT_MODEL=ubot-1
# Optional second-choice provider. Leave unset to run fully offline.
ANTHROPIC_API_KEY=
FALLBACK_MODEL=claude-sonnet-4-6

# Voice
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# Channels
UBOT_BOT_TOKEN=123456:telegram-bot-token

# API
UBOT_API_KEY=change-me          # server-to-server only (Telegram bot, workers)
# Session signing key. SET THIS. If it is absent (or literally "auto") the app
# generates a fresh random one on every boot, which silently invalidates every
# issued JWT — users would have to reconnect their wallet after every restart or
# deploy. Generate once and keep it:
#     openssl rand -hex 32
UBOT_JWT_SECRET=
UBOT_VOICE_SECRET=              # ElevenLabs agent webhook. Separate from the
                                # API key so voice can be rotated/revoked alone.
                                # Leave EMPTY to disable that path entirely
                                # (it then fails closed). Read-only intents:
                                # it may look things up, never spend.
UBOT_AGENT_MAX_USDC=1           # per-CALL ceiling for an agent_query
                                # (0 disables research entirely)
UBOT_AGENT_MAX_PER_HOUR=5       # per-USER calls per hour. The ceiling above is
                                # per call, so without this a caller could loop
                                # agent_query and drain the treasury by pennies.
# Addresses we will sign an x402 payment for, comma separated. Empty = no
# allowlist (the budget still applies) — set this before real funds are involved
# so a rogue 402 cannot name its own payee.
UBOT_X402_PAYEES=
# Public docs. /docs and /openapi.json enumerate all 33 endpoints with no auth.
# Everything sensitive already requires a key, so this is convenience, not a
# hole — but it is a free map of the surface. Enable only for demos where
# showing the API is the point.
UBOT_DOCS_PUBLIC=
# Per-IP quote rate limit (also enforced at the nginx edge). /bridge/quote is
# unauthenticated and each hit costs us a LI.FI + Across call.
UBOT_QUOTE_RATE_PER_MIN=20
UBOT_PORT=8090
UBOT_DB=./ubotpay.db
DEMO_RECIPIENT=0x000000000000000000000000000000000000dEaD

# Demo amounts (USDC) — keep small on mainnet
DEMO_RECIPIENT=0x...        # where 'mom' / invoices get paid (use your own wallet so funds come back)
DEMO_INV_1=5
DEMO_INV_2=3
DEMO_INV_3=12
DEMO_DAILY_LIMIT=40
DEMO_DUAL_THRESHOLD=10
DEMO_RESET_INVOICES=1
DATAAGENT_URL=http://127.0.0.1:8091
# Where the DataAgent stores settled nonces. Must be on persistent storage, not
# a tmpfs: the whole point of round 8 was that an in-memory set lost replay
# protection on every restart.
DATAAGENT_NONCE_DB=./dataagent_nonces.db
# Required only to read payee_usdc from the DataAgent /health endpoint.
DATAAGENT_API_KEY=

# Policy defaults, used when a user has no limit of their own.
# NOTE (audit 20 Oct): a limit of 0 now means "nothing allowed". It used to be
# read as falsy and silently turned into a 1e12 ceiling, i.e. no limit at all.
# Same for dual_threshold: 0 now means "co-sign everything", not "co-sign nothing".
UBOT_DEFAULT_DAILY_LIMIT=40
UBOT_DEFAULT_DUAL_THRESHOLD=10
# Hours from UTC for the "daily limit" day boundary. 7 = Bangkok, so the cap
# resets at local midnight instead of 07:00 local.
UBOT_DAY_TZ_OFFSET=7

# Business model
UBOT_REVENUE_ADDRESS=0x...   # fees land here (your own wallet)
UBOT_FEE_PCT=0.5
UBOT_FEE_MIN_USDC=0.01
UBOT_FX_SPREAD_PCT=0.3
UBOT_AGENT_TAKE_PCT=1.0
